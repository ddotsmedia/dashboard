/**
 * Global Styles
 * Base styles and resets for the entire application
 */

@import './variables.css';

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  direction: ltr;
}

html[dir="rtl"] {
  direction: rtl;
}

body {
  font-family: var(--font-family-base);
  background-color: var(--color-bg);
  color: var(--color-text-primary);
  font-size: var(--font-size-base);
  line-height: var(--line-height-normal);
  transition: background-color var(--transition-base),
    color var(--transition-base);
}

a {
  color: var(--color-info);
  text-decoration: none;
  transition: color var(--transition-fast);
}

a:hover {
  color: var(--color-info-dark);
}

button {
  font-family: inherit;
  cursor: pointer;
}

input,
textarea,
select {
  font-family: inherit;
  font-size: inherit;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius-md);
  padding: 0.5rem;
}

/* Scrollbar styling */
::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  background: var(--color-bg-secondary);
}

::-webkit-scrollbar-thumb {
  background: var(--color-border);
  border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--color-text-tertiary);
}

/* Selection styling */
::selection {
  background-color: var(--color-info);
  color: var(--color-bg);
}

/* Focus styles - Accessible focus indicators */
:focus-visible {
  outline: 2px solid var(--color-info);
  outline-offset: 2px;
}

/* Enhanced focus styles for better visibility */
button:focus-visible,
a:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible,
[role="button"]:focus-visible {
  outline: 2px solid var(--color-info);
  outline-offset: 2px;
}

/* Remove default outline for elements that use focus-visible */
button:focus,
a:focus,
input:focus,
select:focus,
textarea:focus {
  outline: none;
}

/* Dark mode focus indicators */
@media (prefers-color-scheme: dark) {
  :root:not([data-theme='light']) button:focus-visible,
  :root:not([data-theme='light']) a:focus-visible,
  :root:not([data-theme='light']) input:focus-visible,
  :root:not([data-theme='light']) select:focus-visible,
  :root:not([data-theme='light']) textarea:focus-visible {
    outline: 2px solid var(--color-info);
    outline-offset: 2px;
  }
}

/* Explicit dark theme focus */
:root[data-theme='dark'] button:focus-visible,
:root[data-theme='dark'] a:focus-visible,
:root[data-theme='dark'] input:focus-visible,
:root[data-theme='dark'] select:focus-visible,
:root[data-theme='dark'] textarea:focus-visible {
  outline: 2px solid var(--color-info);
  outline-offset: 2px;
}

/* Accessibility */
@media (prefers-reduced-motion: reduce) {
  * {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* Print styles */
@media print {
  body {
    background: white;
    color: black;
  }

  a {
    color: blue;
  }
}

/* RTL Layout Styles using CSS Logical Properties */
/* These properties automatically adjust based on text direction */

/* Sidebar adjustments */
[dir="rtl"] aside {
  border-right: none;
  border-left: 1px solid var(--color-border);
}

/* Text alignment adjustments */
[dir="rtl"] .text-left {
  text-align: end;
}

[dir="rtl"] .text-right {
  text-align: start;
}

/* Flexbox direction for RTL */
[dir="rtl"] .flex-row {
  flex-direction: row-reverse;
}

/* Icon and text alignment in navigation */
[dir="rtl"] nav {
  text-align: end;
}

[dir="rtl"] .nav-item {
  margin-inline-start: auto;
  margin-inline-end: 0;
  padding-inline-start: 1rem;
  padding-inline-end: 0;
}

/* Padding and margin logical properties */
[dir="rtl"] .p-4 {
  padding-inline-start: 1rem;
  padding-inline-end: 1rem;
}

[dir="rtl"] .ml-auto {
  margin-inline-start: auto;
  margin-inline-end: unset;
}

[dir="rtl"] .mr-auto {
  margin-inline-end: auto;
  margin-inline-start: unset;
}

/* Border adjustments */
[dir="rtl"] .border-l {
  border-left: none;
  border-right: 1px solid var(--color-border);
}

[dir="rtl"] .border-r {
  border-right: none;
  border-left: 1px solid var(--color-border);
}
